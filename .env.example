# Copy this file to ".env" and fill in your email provider's SMTP details.
# Until this is filled in, the app will show a preview of each email instead
# of actually sending it — so you can test everything else first.

# Gmail example (use an "app password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password

# Outlook / Microsoft 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=you@klareco.be
#   SMTP_PASSWORD=your-password-or-app-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Klareco Team Building

# Once you deploy the app somewhere reachable (see README), set this to that
# public URL so survey links in emails point to the right place.
APP_BASE_URL=http://localhost:8501
