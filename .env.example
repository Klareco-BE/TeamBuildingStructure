# Copy this file to ".env" and fill in the details below.

# REQUIRED — where the app's data lives (Supabase).
# In your Supabase project: Project Settings → Database → Connection string
# → choose the "Transaction pooler" tab (port 6543) → copy it here, and put
# your real database password in where it says [YOUR-PASSWORD].
#   SUPABASE_DB_URL=postgresql://postgres.xxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Everything below is OPTIONAL. By default, the app opens invite/survey
# emails in your own email program (Outlook, Gmail, etc.) so you just hit
# Send yourself — nothing here needs to be filled in for that.
#
# Only fill this in if you want the app to send emails automatically
# instead, without you clicking Send (the "Advanced" option on each send
# screen).

# Gmail example (use an "app password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password

# Outlook / Microsoft 365 example (may need SMTP AUTH enabled by your IT admin):
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=you@klareco.be
#   SMTP_PASSWORD=your-password-or-app-password

# Resend example (an API key instead of a mailbox password):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_your_api_key

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Klareco Team Building

# Only matters once the app is hosted somewhere with a stable address —
# makes survey links in emails point to the right place instead of
# localhost. Not needed just to send invite emails.
APP_BASE_URL=http://localhost:8501
